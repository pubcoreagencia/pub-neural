# Base URL for PUB Neural Console API
# Local development default: http://127.0.0.1:8080 (appends /api/v1 automatically if omitted)
# Cloudflare Pages production: https://api.pub-neural.example.com
VITE_API_BASE_URL=http://127.0.0.1:8080

# Bearer session token for RLS session authentication (attach_session)
VITE_NEURAL_BEARER_TOKEN=dev_token_for_local_testing_only
